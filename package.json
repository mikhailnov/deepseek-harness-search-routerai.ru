{
  "name": "@local/dsh-web-search-routerai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Веб-поиск через RouterAI (https://routerai.ru) для DeepSeek Harness: провайдер ctx.web с выбором модели и движка поиска (native / exa / auto).",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "vendor"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
